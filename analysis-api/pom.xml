<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MAVEN-070 (doc/architecture/20-backlog-modules-maven-patchs.md) : domaine Analyse, devenu `analysis-api`
        à SILO-155 (doc/architecture/21-plan-silotage.md) : contrat d'entrée AnalyseInput et ses types, modèles
        de résultat et interface de service AnalyseCalculationService. Le moteur (DefaultAnalyseCalculationService)
        vit dans `analysis-core`.

        Silo isolé (SILO-133) : Analyse définit ses propres contrats d'entrée (AnalysisTransaction,
        AnalysisCategory, AnalysisMatching, AnalysisPendingOperation, AnalysisBudgetLine) et n'a aucune
        dépendance de production vers un autre silo. Aucune dépendance vers Spring, JPA, OpenAPI,
        PersistenceManager ni BudgetDataModel, aucune dépendance de test (les tests vivent dans `analysis-core`).
    -->
    <parent>
        <groupId>com.moe.myfamilybudget</groupId>
        <artifactId>domain-analysis</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>analysis-api</artifactId>
    <packaging>jar</packaging>
    <name>analysis-api</name>
    <description>API du silo Analyse MyFamilyBudget (contrats, modèles, interface de service ; sans Spring ni JPA)</description>


    <build>
        <plugins>
            <!--
                REL-030 : japicmp compare l'API binaire de ce module a sa derniere version publiee
                (oldVersion=RELEASE). ignoreMissingOldVersion=true : ne fait pas echouer le build s'il n'y a
                encore aucune version publiee (silo tout juste cree). breakBuildOnBinaryIncompatibleModifications
                reste a true (herite de <pluginManagement> dans le pom racine) : un changement binaire non
                retrocompatible fait echouer `mvn verify`/`mvn clean verify`. Rapport : target/japicmp/japicmp.diff
                (et .xml) apres `mvn verify`.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>com.moe.myfamilybudget</groupId>
                            <artifactId>analysis-api</artifactId>
                            <version>RELEASE</version>
                        </dependency>
                    </oldVersion>
                    <parameter>
                        <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <id>japicmp</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
